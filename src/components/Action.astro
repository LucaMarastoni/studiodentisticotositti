---
import Arrow from './Arrow.astro';
interface Props { href: string; variant?: 'primary' | 'outline' | 'text' | 'light'; label?: string; class?: string }
const { href, variant = 'primary', label, class: className = '' } = Astro.props;
---
<a href={href} class:list={['button', `button--${variant}`, className]} aria-label={label}><span><slot /></span><Arrow /></a>
