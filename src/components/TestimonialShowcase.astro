---
import { testimonialPlaceholders } from '../data/videos';
import { pathFor } from '../utils/paths';
---

<div class="testimonial-grid" aria-label="Testimonianze video in preparazione">
  {testimonialPlaceholders.map((item) => (
    <article class:list={['testimonial-card', { 'testimonial-card--featured': item.featured }]} data-image-reveal>
      <img
        src={pathFor(item.poster.src)}
        width={item.poster.width}
        height={item.poster.height}
        alt=""
        loading="lazy"
      />
      <div class="testimonial-card__veil" aria-hidden="true"></div>
      <div class="testimonial-card__content">
        <span class="testimonial-card__number">{item.number}</span>
        <span class="testimonial-card__play" aria-hidden="true">
          <svg width="18" height="20" viewBox="0 0 18 20" fill="none">
            <path d="m4 3 11 7-11 7V3Z" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </span>
        <div>
          <h3>{item.label}</h3>
          <p>{item.note}</p>
        </div>
      </div>
    </article>
  ))}
</div>
